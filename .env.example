# Nekita - configuracion (copia a .env y rellena NEKITA_TOKEN)
NEKITA_TOKEN=
NEKITA_MASTER_ID=
NEKITA_TZ=Europe/Madrid
NEKITA_CACHE_SEGUNDOS=300
NEKITA_DATA_DIR=~/.nekita/data
NEKITA_LOG_LEVEL=INFO
NEKITA_LOG_MESSAGES=false
NEKITA_BACKUP_HORA=04:00
NEKITA_MAX_HANDLERS=20
NEKITA_BACKUP_COPIA_CMD=
# IA remota (opcional, Fase 8): vacio = desactivada
NEKITA_AI_URL=
NEKITA_AI_MODEL=
NEKITA_AI_KEY=
NEKITA_AI_TIMEOUT=20
